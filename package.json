{
  "name": "lnr",
  "version": "0.31.4",
  "private": true,
  "description": "lnr (linearctl) — a headless CLI for frequently ad-hocced Linear workflows (digest, file, triage, milestone), built on @linear/sdk.",
  "type": "module",
  "bin": {
    "lnr": "dist/lnr",
    "linearctl": "dist/linearctl"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "whoami": "bun run src/index.ts whoami",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build ./src/index.ts --compile --minify --define 'process.env.DEV=\"false\"' --outfile dist/lnr && cp -f dist/lnr dist/linearctl",
    "dev:watch": "bun --watch run src/index.ts",
    "test:watch": "bun test --watch",
    "test:fast": "bun test --filter",
    "lint": "bun run typecheck",
    "ci": "bun run typecheck && bun test",
    "bench:cache": "bun run scripts/benchmark-cache.ts",
    "cpm:check": "./scripts/cpm-wave-runner.sh --check",
    "cpm:wave-runner": "./scripts/cpm-wave-runner.sh --wave all",
    "dev:all": "bun run typecheck && bun test && bun run build",
    "quick": "bun run src/index.ts"
  },
  "keywords": [
    "linear",
    "cli",
    "workflow",
    "issue-tracking",
    "bun"
  ],
  "author": "Christian M. Todie <chris@todie.io>",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@linear/sdk": "^86.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "drizzle-orm": "^0.45.3",
    "ink": "^7.1.1",
    "picocolors": "^1.1.1",
    "react": "^19.2.8",
    "react-devtools-core": "^7.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "graphql": "^17.0.2",
    "ink-testing-library": "^4.0.0",
    "typescript": "^6.0.3"
  }
}
